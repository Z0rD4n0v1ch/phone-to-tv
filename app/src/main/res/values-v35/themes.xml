<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 растягивает окно под шапку и системные панели — отключаем, иначе верх экрана прячется под заголовком -->
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="AppTheme.Fullscreen" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
